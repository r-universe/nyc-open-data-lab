[submodule ".registry"]
	path = .registry
	url = https://github.com/r-universe-org/cran-to-git
	branch = HEAD
[submodule "SeattleOpenData"]
	path = SeattleOpenData
	url = https://github.com/nyc-open-data-lab/seattleopendata
[submodule "cincinnatiOpenData"]
	path = cincinnatiOpenData
	url = https://github.com/nyc-open-data-lab/cincinnatiopendata
[submodule "ctOpenData"]
	path = ctOpenData
	url = https://github.com/nyc-open-data-lab/ctopendata
[submodule "nolaOpenData"]
	path = nolaOpenData
	url = https://github.com/nyc-open-data-lab/nolaopendata
